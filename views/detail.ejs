<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= briefing.subject %> | CH-AIDE 브리핑</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header>
    <div class="header-inner">
      <div>
        <h1>📋 CH-AIDE 브리핑</h1>
        <p class="subtitle">ch-aide@aidepartners.com 수신 PDF 자동 브리핑</p>
      </div>
      <a href="/" class="btn-check">← 목록으로</a>
    </div>
  </header>

  <main>
    <div class="detail-card">
      <div class="detail-meta">
        <span class="badge">📅 <%= briefing.mail_date %></span>
        <span class="badge">📄 <%= briefing.pdf_filename %></span>
        <% if (briefing.pdf_viewer_url) { %>
          <a href="<%= briefing.pdf_viewer_url %>" target="_blank" class="badge badge-link">🔗 원문 보기</a>
        <% } else if (briefing.pdf_url) { %>
          <a href="<%= briefing.pdf_url %>" target="_blank" class="badge badge-link">🔗 원문 보기</a>
        <% } %>
      </div>
      <h2 class="detail-title"><%= briefing.subject %></h2>
      <div class="divider"></div>
      <div class="detail-content summary-content">
        <%- briefing.summary_html %>
      </div>

      <% if (chartPages && chartPages.length > 0) { %>
      <div class="chart-gallery">
        <div class="chart-gallery-header">
          <span>📊 차트 & 그래프 원본 페이지</span>
          <span class="chart-count"><%= chartPages.length %>페이지</span>
        </div>
        <div class="chart-grid">
          <% for (const pageNum of chartPages) { %>
          <div class="chart-item">
            <img
              src="/briefing/<%= briefing.id %>/page/<%= pageNum %>"
              alt="PDF p.<%= pageNum %>"
              loading="lazy"
              class="chart-img"
              onclick="toggleExpand(this)"
            />
            <div class="chart-page-label">p.<%= pageNum %></div>
          </div>
          <% } %>
        </div>
      </div>
      <% } %>
    </div>
  </main>

  <script>
    function toggleExpand(img) {
      img.classList.toggle('chart-img-expanded');
      img.closest('.chart-item').classList.toggle('chart-item-expanded');
    }
  </script>

  <footer><p>1시간마다 자동 확인 · 새 브리핑 도착 시 텔레그램 알림</p></footer>
</body>
</html>
