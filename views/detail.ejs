<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= briefing.subject %> | CH-AIDE 브리핑</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header>
    <div class="header-inner">
      <div>
        <h1>📋 CH-AIDE 브리핑</h1>
        <p class="subtitle">ch-aide@aidepartners.com 수신 PDF 자동 브리핑</p>
      </div>
      <a href="/" class="btn-check">← 목록으로</a>
    </div>
  </header>

  <main>
    <div class="detail-card">
      <div class="detail-meta">
        <span class="badge">📅 <%= briefing.mail_date %></span>
        <span class="badge">📄 <%= briefing.pdf_filename %></span>
        <% if (briefing.pdf_viewer_url) { %>
          <a href="<%= briefing.pdf_viewer_url %>" target="_blank" class="badge badge-link">🔗 원문 보기</a>
        <% } else if (briefing.pdf_url) { %>
          <a href="<%= briefing.pdf_url %>" target="_blank" class="badge badge-link">🔗 원문 보기</a>
        <% } %>
      </div>
      <h2 class="detail-title"><%= briefing.subject %></h2>
      <div class="divider"></div>
      <div class="detail-content summary-content">
        <%- briefing.summary_html %>
      </div>

    </div>
  </main>


  <footer><p>1시간마다 자동 확인 · 새 브리핑 도착 시 텔레그램 알림</p></footer>

  <!-- 이미지 라이트박스 -->
  <div id="lightbox" class="lightbox" role="dialog" aria-modal="true">
    <button class="lightbox-close" id="lightbox-close" aria-label="닫기">✕</button>
    <div class="lightbox-bg" id="lightbox-bg"></div>
    <img class="lightbox-img" id="lightbox-img" src="" alt="차트 확대" />
  </div>

  <script>
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img');
    const lightboxClose = document.getElementById('lightbox-close');
    const lightboxBg = document.getElementById('lightbox-bg');

    function openLightbox(src) {
      lightboxImg.src = src;
      lightbox.classList.add('active');
      document.body.style.overflow = 'hidden';
      history.pushState({ lightbox: true }, '');
    }

    function closeLightbox() {
      lightbox.classList.remove('active');
      document.body.style.overflow = '';
      lightboxImg.src = '';
    }

    // 인라인 차트 이미지 클릭 → 라이트박스
    document.querySelectorAll('.inline-chart img').forEach(img => {
      img.style.cursor = 'zoom-in';
      img.removeAttribute('onclick');
      img.addEventListener('click', () => openLightbox(img.src));
    });

    // 닫기 버튼 / 배경 클릭
    lightboxClose.addEventListener('click', () => { history.back(); });
    lightboxBg.addEventListener('click', () => { history.back(); });

    // 뒤로가기 → 라이트박스 닫기
    window.addEventListener('popstate', (e) => {
      if (lightbox.classList.contains('active')) closeLightbox();
    });
  </script>
</body>
</html>
